<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live navigation: satellite GPS fix only (see LocationTracker) — never
         network/cell-tower based location there, which on stock Android
         resolves via an online Google service and would be far too coarse
         (often hundreds of meters) to track position against a route.
         One-shot "locate me" lookups (map recenter, search's "use current
         location") do race NETWORK_PROVIDER alongside GPS — see
         LocationTracker.updates(includeNetwork). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ silently downgrades a FINE-only request to COARSE-only
         unless COARSE is also declared — this app's own code only ever acts
         on a granted ACCESS_FINE_LOCATION (see MainActivity/SearchLocation-
         Activity/LiveNavigationActivity), so without this the live-GPS path
         would quietly stop working on modern devices. Also what gates
         NETWORK_PROVIDER for one-shot lookups (see above) — it needs an
         actual internet connection to resolve to coordinates, so it simply
         does nothing on a genuinely offline device. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- This app targets keypad-only devices with no touchscreen (see
         feedback-movitop-dpad-convention) — without this, Android treats
         a touchscreen as required by default and filters the app away from
         exactly the hardware it's built for. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Movitop"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Movitop.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".search.SearchLocationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DataImportActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".LineTimesActivity"
            android:exported="false" />

        <activity
            android:name=".LiveNavigationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".MotisForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Offline transit routing engine (localhost server)" />
        </service>
    </application>

</manifest>