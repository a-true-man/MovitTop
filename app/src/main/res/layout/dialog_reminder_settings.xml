<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_reminder_dialog_title"
        android:textColor="@color/movitop_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Stops-before stepper: explicit -/+ buttons, no SeekBar/NumberPicker, so it stays D-Pad-safe. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reminderStopsBeforeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/movitop_text_primary"
            android:textSize="14sp"
            tools:text="התראה 2 תחנות לפני" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderStopsMinusButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="−"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderStopsPlusButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="+"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/nav_reminder_alert_mode_label"
        android:textColor="@color/movitop_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderModeSoundButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/nav_reminder_mode_sound"
            android:textSize="12sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderModeVibrateButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/nav_reminder_mode_vibrate"
            android:textSize="12sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderModeBothButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/nav_reminder_mode_both"
            android:textSize="12sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/nav_reminder_volume"
        android:textColor="@color/movitop_text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/reminderVolumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/movitop_divider" />

    <!-- Placeholder only — no TTS implementation yet; disabled + unfocusable so D-Pad traversal skips it. -->
    <TextView
        android:id="@+id/voiceNavPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.5"
        android:enabled="false"
        android:focusable="false"
        android:text="@string/nav_voice_nav_placeholder"
        android:textColor="@color/movitop_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reminderSaveButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="@string/nav_reminder_save"
        app:cornerRadius="12dp" />

</LinearLayout>
