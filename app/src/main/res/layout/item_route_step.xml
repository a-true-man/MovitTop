<?xml version="1.0" encoding="utf-8"?>
<!-- A single step in the route detail list. Focusable for D-Pad navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minHeight="48dp"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/stepDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_step_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/movitop_text_primary"
            tools:text="קו 480 לכיוון ירושלים" />

        <TextView
            android:id="@+id/stepSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/movitop_text_secondary"
            android:visibility="gone"
            tools:text="אגד · תחנה מרכזית"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/stepTimeRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/movitop_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="14:20"
        tools:visibility="visible" />

</LinearLayout>
