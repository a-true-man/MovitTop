<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nearbyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movitop_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nearbyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/movitop_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/nearby_title"
        app:titleTextColor="@color/movitop_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nearby_subtitle"
            android:textColor="@color/movitop_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nearbyRefreshButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/nearby_refresh"
            android:nextFocusDown="@id/nearbyRecycler"
            app:icon="@drawable/ic_my_location"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="@color/movitop_primary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/nearbyProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/movitop_primary"
        android:visibility="visible" />

    <TextView
        android:id="@+id/nearbyEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="@string/nearby_empty"
        android:textColor="@color/movitop_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nearbyRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:listitem="@layout/item_nearby_departure" />

</LinearLayout>
