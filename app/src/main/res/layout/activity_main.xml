<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <org.mapsforge.map.android.view.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:nextFocusUp="@id/dataImportButton" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/movitop_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/movitop_input_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/searchForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Header row: settings + line-times entry points -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/settings_button_description"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/movitop_text_secondary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lineTimesButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/line_times_button_description"
                        app:icon="@drawable/ic_schedule"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/movitop_text_secondary" />
                </LinearLayout>

                <!-- Origin row -->
                <LinearLayout
                    android:id="@+id/originRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_field"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:nextFocusDown="@id/destinationRow"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ic_origin_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_origin_hint"
                            android:textColor="@color/movitop_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/originText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:hint="@string/search_tap_to_choose"
                            android:maxLines="1"
                            android:textColor="@color/movitop_text_primary"
                            android:textColorHint="@color/movitop_text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Destination row -->
                <LinearLayout
                    android:id="@+id/destinationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_field"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:nextFocusDown="@id/tripTimeRow"
                    android:nextFocusUp="@id/originRow"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ic_destination_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_destination_hint"
                            android:textColor="@color/movitop_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/destinationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:hint="@string/search_tap_to_choose"
                            android:maxLines="1"
                            android:textColor="@color/movitop_text_primary"
                            android:textColorHint="@color/movitop_text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tripTimeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_field"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/destinationRow"
                    android:nextFocusDown="@id/searchButton"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/trip_time_now"
                    android:textColor="@color/movitop_primary"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_schedule" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:nextFocusUp="@id/tripTimeRow"
                    android:text="@string/search_button"
                    android:textSize="16sp"
                    app:backgroundTint="@color/movitop_primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/movitop_on_primary" />

                <ProgressBar
                    android:id="@+id/searchProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/movitop_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Map controls: D-Pad-focusable zoom/location/import stack (see
             MainActivity's key handling) — Mapsforge's own pinch/drag
             gestures only work on a touchscreen, so keypad-only devices
             need explicit buttons for every map interaction. -->
        <LinearLayout
            android:id="@+id/mapControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomInButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/map_zoom_in"
                android:nextFocusDown="@id/zoomOutButton"
                app:backgroundTint="@color/movitop_surface"
                app:icon="@drawable/ic_zoom_in"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/movitop_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomOutButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/map_zoom_out"
                android:nextFocusUp="@id/zoomInButton"
                android:nextFocusDown="@id/myLocationButton"
                app:backgroundTint="@color/movitop_surface"
                app:icon="@drawable/ic_zoom_out"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/movitop_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/myLocationButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/map_my_location"
                android:nextFocusUp="@id/zoomOutButton"
                android:nextFocusDown="@id/dataImportButton"
                app:backgroundTint="@color/movitop_surface"
                app:icon="@drawable/ic_my_location"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataImportButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/data_import_button_description"
                android:nextFocusUp="@id/myLocationButton"
                android:nextFocusDown="@id/mapView"
                app:backgroundTint="@color/movitop_surface"
                app:icon="@drawable/ic_import"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/movitop_text_secondary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/layout_bottom_sheet_results" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
