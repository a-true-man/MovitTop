<?xml version="1.0" encoding="utf-8"?>
<!-- Results bottom sheet. peekHeight=0 keeps it fully hidden until routes are
     ready; the ViewModel triggers expansion. It hosts two swappable panes:
     the 5-option summary and the step-by-step route details. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultsBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:descendantFocusability="afterDescendants"
    android:elevation="12dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:maxHeight="420dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Pane 1: direct-modes row + transit suggestions -->
        <LinearLayout
            android:id="@+id/summaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/directModesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="6dp"
                android:text="@string/direct_modes_title"
                android:textColor="@color/movitop_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/directModesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                tools:listitem="@layout/item_direct_mode"
                tools:orientation="horizontal" />

            <TextView
                android:id="@+id/transitOptionsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="6dp"
                android:text="@string/transit_options_title"
                android:textColor="@color/movitop_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/resultsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_route_option" />
        </LinearLayout>

        <!-- Pane 2: step-by-step details. Styled with the same card language
             (movitop_surface / 16dp corners / 1dp stroke) as the results
             pane's cards so the two panes read as one continuous screen. -->
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Quick-switch row: every option from the last search, so
                 picking a different one re-opens its detail in place instead
                 of forcing a new search. Hidden when there's only one route. -->
            <TextView
                android:id="@+id/routeSwitchTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="6dp"
                android:text="@string/route_switch_title"
                android:textColor="@color/movitop_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routeSwitchRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                tools:listitem="@layout/item_route_switch_option"
                tools:orientation="horizontal"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="5dp"
                app:cardBackgroundColor="@color/movitop_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/movitop_input_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/detailsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/route_details_title"
                            android:textColor="@color/movitop_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detailsDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/movitop_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="45 דק׳" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/movitop_divider" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detailsRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:descendantFocusability="afterDescendants"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="16dp"
                        tools:listitem="@layout/item_route_step" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startNavigationButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/start_navigation"
                app:backgroundTint="@color/movitop_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_mode_walk"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Pane 3: departures at a map-tapped stop. stopBackButton only
             shows once drilled into one line's full schedule (see
             MainActivity.showLineScheduleAtStop); tapping it returns to the
             stop's mixed-lines departure list instead of closing the sheet. -->
        <LinearLayout
            android:id="@+id/stopDeparturesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/stopBackButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stop_departures_back_description"
                    android:src="@drawable/ic_back"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/stopDeparturesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/movitop_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="תחנה מרכזית" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stopDeparturesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_nearby_departure" />

            <TextView
                android:id="@+id/stopDeparturesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/stop_info_no_routes"
                android:textColor="@color/movitop_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
