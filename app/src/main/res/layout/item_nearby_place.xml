<?xml version="1.0" encoding="utf-8"?>
<!-- One nearby Rav-Kav charging station or POI (restaurant/shop/pharmacy/...)
     in the Home sheet's mixed nearby list — see NearbyListAdapter. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/movitop_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/movitop_input_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <View
            android:id="@+id/placeColorDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_step_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/placeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/movitop_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="קפה גרג" />

            <TextView
                android:id="@+id/placeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/movitop_text_secondary"
                android:textSize="12sp"
                tools:text="אוכל ושתייה · 120 מ׳ מכאן" />

        </LinearLayout>

        <TextView
            android:id="@+id/placeOpenNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="פתוח"
            tools:textColor="@color/movitop_departs_soon"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
