<?xml version="1.0" encoding="utf-8"?>
<!-- One past or pinned origin→destination trip in the Home sheet's horizontal row. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/movitop_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/movitop_input_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tripHistoryOrigin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/movitop_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="הבית" />

            <ImageButton
                android:id="@+id/tripHistoryPinButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/trip_history_pin_description"
                android:src="@drawable/ic_star"
                app:tint="@color/movitop_star_active"
                tools:ignore="UseAppTint" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_history_arrow"
            android:textColor="@color/movitop_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tripHistoryDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/movitop_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="העבודה" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
