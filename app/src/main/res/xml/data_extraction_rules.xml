<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- The offline MOTIS transit graph + map + schedule DB (see
         MotisForegroundService.motisDataDir) lives under filesDir/motis_data/
         and can be several GB — it's re-importable offline data, not user
         content, so backing/transferring it would be slow and pointless. -->
    <cloud-backup>
        <exclude domain="file" path="motis_data/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="motis_data/" />
    </device-transfer>
</data-extraction-rules>