<?xml version="1.0" encoding="utf-8"?>
<!-- The app only ever talks to its own on-device MOTIS server at
     127.0.0.1 (see MotisBinaryManager.BASE_URL) — never any other host —
     so cleartext HTTP is permitted for localhost only, not app-wide. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
