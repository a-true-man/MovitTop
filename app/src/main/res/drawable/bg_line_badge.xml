<?xml version="1.0" encoding="utf-8"?>
<!-- The colored pill behind a line's number — same visual language as real
     transit signage (Moovit/Google Maps line chips), so a line reads as a
     line at a glance instead of a bare row of text. The fill is overwritten
     per-badge in code with that leg's own color (see RouteAdapter.bindBadges
     + LegColors.contentColorFor, which picks readable text for whatever that
     color turns out to be); the stroke stays this fixed, themed neutral so a
     pale line color still has a visible edge against the card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/movitop_primary" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/movitop_input_stroke" />
</shape>
