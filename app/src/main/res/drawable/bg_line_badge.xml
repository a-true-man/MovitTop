<?xml version="1.0" encoding="utf-8"?>
<!-- The colored pill behind a line's number — same visual language as real
     transit signage (Moovit/Google Maps line chips), so a line reads as a
     line at a glance instead of a bare row of text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/movitop_primary" />
    <corners android:radius="10dp" />
</shape>
