<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). -->
    <style name="Base.Theme.Movitop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/movitop_primary</item>
        <item name="colorPrimaryDark">@color/movitop_primary_dark</item>
        <item name="colorOnPrimary">@color/movitop_on_primary</item>
        <item name="android:colorBackground">@color/movitop_background</item>
        <item name="colorSurface">@color/movitop_surface</item>
        <item name="colorOnSurface">@color/movitop_text_primary</item>
        <item name="android:statusBarColor">@color/movitop_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Movitop" parent="Base.Theme.Movitop" />

    <!-- Quick-location chip styling (Waze-like solid rounded). -->
    <style name="Widget.Movitop.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/movitop_chip_bg</item>
        <item name="android:textColor">@color/movitop_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
    </style>
</resources>
