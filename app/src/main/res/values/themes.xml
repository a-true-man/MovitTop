<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). -->
    <style name="Base.Theme.Movitop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/movitop_primary</item>
        <item name="colorPrimaryDark">@color/movitop_primary_dark</item>
        <item name="colorOnPrimary">@color/movitop_on_primary</item>
        <item name="colorSecondary">@color/movitop_accent</item>
        <item name="android:colorBackground">@color/movitop_background</item>
        <item name="colorSurface">@color/movitop_surface</item>
        <item name="colorOnSurface">@color/movitop_text_primary</item>
        <item name="colorSurfaceVariant">@color/movitop_input_bg</item>
        <item name="colorOutline">@color/movitop_input_stroke</item>
        <item name="android:statusBarColor">@color/movitop_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.Movitop.Card</item>
    </style>

    <style name="Widget.Movitop.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/movitop_input_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Theme.Movitop" parent="Base.Theme.Movitop" />

    <!-- Splash screen: solid brand background so there's no white flash
         between process start and the animated layout taking over. -->
    <style name="Theme.Movitop.Splash" parent="Theme.Movitop">
        <item name="android:windowBackground">@color/movitop_primary_dark</item>
        <item name="android:statusBarColor">@color/movitop_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Quick-location chip styling (Waze-like solid rounded). -->
    <style name="Widget.Movitop.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/movitop_chip_bg</item>
        <item name="android:textColor">@color/movitop_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
    </style>
</resources>
